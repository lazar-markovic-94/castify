# Development/Staging Environment Configuration
# Copy this file to .env.develop and update with actual values
# DO NOT commit .env.develop with real credentials

SPRING_PROFILES_ACTIVE=develop

# Database Configuration
DB_URL=jdbc:postgresql://dev-db-server.example.com:5432/castify_dev
DB_USERNAME=castify_dev_user
DB_PASSWORD=CHANGE_THIS_TO_ACTUAL_DEV_PASSWORD

# Server Configuration
SERVER_PORT=8080

# File Upload
UPLOAD_DIR=/var/castify/uploads

# JWT Configuration
# IMPORTANT: Use a strong, unique secret for development environment
# Generate using: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_ACTUAL_DEV_JWT_SECRET_MIN_256_BITS
JWT_EXPIRATION_MS=86400000
