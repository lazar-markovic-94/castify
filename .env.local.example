# Local Development Environment Configuration
# Copy this file to .env.local and adjust values as needed

SPRING_PROFILES_ACTIVE=local

# Database Configuration
DB_USERNAME=lazarmarkovic
DB_PASSWORD=

# Server Configuration
SERVER_PORT=8080

# File Upload
UPLOAD_DIR=uploads

# JWT Configuration (for local testing only)
JWT_SECRET=local-dev-secret-key-change-this-in-production-please-make-it-long-enough-for-testing
JWT_EXPIRATION_MS=86400000

# CORS Configuration (comma-separated list of allowed origins)
# For local development, multiple localhost ports are allowed by default in application-local.yml
# Uncomment and customize if you need different ports:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200
