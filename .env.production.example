# Production Environment Configuration
# NEVER commit .env.production with real credentials to version control
# Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.) in production

SPRING_PROFILES_ACTIVE=production

# Database Configuration (REQUIRED)
# Example for AWS RDS PostgreSQL
DB_URL=jdbc:postgresql://prod-db.example.com:5432/castify_prod
DB_USERNAME=castify_prod_user
DB_PASSWORD=USE_SECRETS_MANAGER_FOR_PRODUCTION_PASSWORD

# Server Configuration
SERVER_PORT=8080

# File Upload
# For production, consider using cloud storage (S3, Azure Blob, GCS)
UPLOAD_DIR=/var/castify/uploads

# JWT Configuration (REQUIRED)
# CRITICAL: Use a strong, unique secret different from development
# Generate using: openssl rand -base64 64
# Store in secrets manager, not in plain text
JWT_SECRET=USE_SECRETS_MANAGER_FOR_PRODUCTION_JWT_SECRET
JWT_EXPIRATION_MS=86400000

# CORS Configuration (REQUIRED)
# CRITICAL: Set this to your ACTUAL production frontend URLs
# DO NOT use localhost or wildcards in production
# Example: ALLOWED_ORIGINS=https://castify.com,https://app.castify.com,https://www.castify.com
ALLOWED_ORIGINS=https://castify.com,https://app.castify.com,https://www.castify.com

# Optional: Database connection pool tuning
# Uncomment and adjust if needed
# HIKARI_MAX_POOL_SIZE=20
# HIKARI_MIN_IDLE=10

# Optional: Monitoring and observability
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
