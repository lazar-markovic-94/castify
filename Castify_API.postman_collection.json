				{
					"name": "Register User (Talent)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"talent_token\", jsonData.token);",
									"    pm.environment.set(\"talent_user_id\", jsonData.userId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newtalent@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"TALENT\",\n  \"phone\": \"+1234567890\"\n}"
						},
