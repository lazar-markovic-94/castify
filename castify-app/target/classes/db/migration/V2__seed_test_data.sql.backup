-- Conversation between ABC Productions (Client) and John Actor (Talent)
INSERT INTO conversation (conversation_id, talent_user_id, client_user_id, created_at, last_message_at) VALUES
('conv1111-1111-1111-1111-111111111111', 'a1111111-1111-1111-1111-111111111111', 'b1111111-1111-1111-1111-111111111111', CURRENT_TIMESTAMP - INTERVAL '2 days', CURRENT_TIMESTAMP - INTERVAL '1 hour');

INSERT INTO message (message_id, conversation_id, sender_user_id, content, sent_at, is_read, read_at) VALUES
('msg11111-1111-1111-1111-111111111111', 'conv1111-1111-1111-1111-111111111111', 'b1111111-1111-1111-1111-111111111111', 'Hi John! We loved your demo reel. We have an upcoming action film project and would like to discuss a potential role with you.', CURRENT_TIMESTAMP - INTERVAL '2 days', true, CURRENT_TIMESTAMP - INTERVAL '1 day 23 hours'),
('msg11112-1111-1111-1111-111111111111', 'conv1111-1111-1111-1111-111111111111', 'a1111111-1111-1111-1111-111111111111', 'Thank you so much! I would love to hear more about the project. When would be a good time to discuss?', CURRENT_TIMESTAMP - INTERVAL '1 day 23 hours', true, CURRENT_TIMESTAMP - INTERVAL '1 day 22 hours'),
('msg11113-1111-1111-1111-111111111111', 'conv1111-1111-1111-1111-111111111111', 'b1111111-1111-1111-1111-111111111111', 'How about tomorrow at 2 PM PST for a video call? I can send you the script beforehand.', CURRENT_TIMESTAMP - INTERVAL '1 day 22 hours', true, CURRENT_TIMESTAMP - INTERVAL '1 day 20 hours'),
('msg11114-1111-1111-1111-111111111111', 'conv1111-1111-1111-1111-111111111111', 'a1111111-1111-1111-1111-111111111111', 'Perfect! That works for me. Looking forward to reading the script.', CURRENT_TIMESTAMP - INTERVAL '1 day 20 hours', true, CURRENT_TIMESTAMP - INTERVAL '1 hour'),
('msg11115-1111-1111-1111-111111111111', 'conv1111-1111-1111-1111-111111111111', 'b1111111-1111-1111-1111-111111111111', 'Great! I will send you the meeting link and script by end of day. Excited to work with you!', CURRENT_TIMESTAMP - INTERVAL '1 hour', false, NULL);

-- Conversation between Creative Minds Agency and Sarah Voice
INSERT INTO conversation (conversation_id, talent_user_id, client_user_id, created_at, last_message_at) VALUES
('conv2222-2222-2222-2222-222222222222', 'a2222222-2222-2222-2222-222222222222', 'b2222222-2222-2222-2222-222222222222', CURRENT_TIMESTAMP - INTERVAL '5 days', CURRENT_TIMESTAMP - INTERVAL '3 days');

INSERT INTO message (message_id, conversation_id, sender_user_id, content, sent_at, is_read, read_at) VALUES
('msg22221-2222-2222-2222-222222222222', 'conv2222-2222-2222-2222-222222222222', 'b2222222-2222-2222-2222-222222222222', 'Hi Sarah! We represent several voice artists and noticed your impressive portfolio. Would you be interested in joining our agency?', CURRENT_TIMESTAMP - INTERVAL '5 days', true, CURRENT_TIMESTAMP - INTERVAL '4 days 22 hours'),
('msg22222-2222-2222-2222-222222222222', 'conv2222-2222-2222-2222-222222222222', 'a2222222-2222-2222-2222-222222222222', 'Hello! Thank you for reaching out. I would definitely be interested in learning more about Creative Minds Agency.', CURRENT_TIMESTAMP - INTERVAL '4 days 22 hours', true, CURRENT_TIMESTAMP - INTERVAL '3 days'),
('msg22223-2222-2222-2222-222222222222', 'conv2222-2222-2222-2222-222222222222', 'b2222222-2222-2222-2222-222222222222', 'Wonderful! Let me send you our agency overview and representation agreement. We have some exciting audiobook projects coming up.', CURRENT_TIMESTAMP - INTERVAL '3 days', false, NULL);

-- Conversation between Brand Studios and Emma Singer
INSERT INTO conversation (conversation_id, talent_user_id, client_user_id, created_at, last_message_at) VALUES
('conv3333-3333-3333-3333-333333333333', 'a4444444-4444-4444-4444-444444444444', 'b3333333-3333-3333-3333-333333333333', CURRENT_TIMESTAMP - INTERVAL '1 day', CURRENT_TIMESTAMP - INTERVAL '6 hours');

INSERT INTO message (message_id, conversation_id, sender_user_id, content, sent_at, is_read, read_at) VALUES
('msg33331-3333-3333-3333-333333333333', 'conv3333-3333-3333-3333-333333333333', 'b3333333-3333-3333-3333-333333333333', 'Hi Emma! We are creating a campaign for a major beverage brand and your music style would be perfect. Interested in licensing your latest single?', CURRENT_TIMESTAMP - INTERVAL '1 day', true, CURRENT_TIMESTAMP - INTERVAL '22 hours'),
('msg33332-3333-3333-3333-333333333333', 'conv3333-3333-3333-3333-333333333333', 'a4444444-4444-4444-4444-444444444444', 'Absolutely! I would love to discuss the details. What is the budget range and usage rights?', CURRENT_TIMESTAMP - INTERVAL '22 hours', true, CURRENT_TIMESTAMP - INTERVAL '6 hours'),
('msg33333-3333-3333-3333-333333333333', 'conv3333-3333-3333-3333-333333333333', 'b3333333-3333-3333-3333-333333333333', 'Great! The campaign will run for 6 months across digital platforms. Let me send you the full proposal with budget details.', CURRENT_TIMESTAMP - INTERVAL '6 hours', false, NULL);

